struct Point {
    x: i32,
    y: i32,
}

function move_x(p: Point, dx: i32) -> Point {
    let mut q = p;
    q.x = q.x + dx;
    return q;
}

function set_first(items: Array<i32>, v: i32) -> i32 {
    let mut buf = items;
    buf[0] = v;
    return buf[0];
}

function main() -> i32 {
    let p = Point { x: 1, y: 2 };
    let mut m = p;
    m.x = 10;
    return move_x(m, 3).x;
}
